# ─── Database ──────────────────────────────────────────────────────────────
# Local dev: SQLite file, no setup needed.
DATABASE_URL="file:./dev.db"
# Production (switch prisma/schema.prisma provider to "postgresql" first):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── WhatsApp Cloud API (shared demo number) ───────────────────────────────
# From Meta > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# You invent this string; paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN="docslot-verify-change-me"
# Graph API version
WHATSAPP_API_VERSION="v22.0"

# ─── App ───────────────────────────────────────────────────────────────────
# Used to build wa.me deep links shown in the portal (digits only, with country code)
SHARED_WHATSAPP_NUMBER="15551234567"
# Public base URL of this app once deployed (no trailing slash)
APP_URL="http://localhost:3000"
