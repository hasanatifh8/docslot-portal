// DocSlot HMS — data model
// Note: the tenant model is still called `Clinic` (table name kept so existing
// data survives `db push`); the UI calls it a hospital.
// Deployed on Postgres (Neon free tier). For local dev without a Postgres
// instance, point DATABASE_URL at the same free Neon database, or switch
// `provider` back to "sqlite" temporarily.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ────────────────────────────────────────────────────────────────

model Clinic {
  id       String @id @default(cuid())
  name     String
  // Short slug patients send as the first WhatsApp message so the shared demo
  // number knows which clinic they want, e.g. wa.me/<num>?text=sunrise
  code     String @unique
  timezone String @default("Asia/Kolkata")

  // Location + prep info sent right after a booking is confirmed
  addressText      String?
  mapsUrl          String?
  prepInstructions String?

  // WhatsApp Cloud API — set once the clinic runs on its OWN number.
  // Left null during the shared-demo-number phase.
  whatsappPhoneNumberId String? @unique
  whatsappToken         String?

  // Reminder offsets in minutes before the appointment
  reminderOffsets String @default("1440,120") // 24h, 2h

  // Next patient UHID sequence number (see lib/patients.ts)
  nextUhid      Int     @default(1)
  // Next invoice number (see lib/billing.ts)
  nextInvoiceNo Int     @default(1)
  phone         String?
  // Suspended hospitals can't sign in (platform admin, /admin)
  active        Boolean @default(true)
  // Monthly collection target in paise (0 = none) — Finance dashboard
  monthlyTarget Int     @default(0)

  createdAt DateTime @default(now())

  users         User[]
  departments   Department[]
  doctors       Doctor[]
  holidays      Holiday[]
  patients      Patient[]
  appointments  Appointment[]
  conversations Conversation[]
  visits        Visit[]
  invoices      Invoice[]
  services      ServiceItem[]
  auditLogs     AuditLog[]
  templates     ConsultTemplate[]
  expenses      Expense[]
  labReports    LabReport[]
}

// ─── Portal auth ───────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email              String   @unique
  passwordHash       String
  name               String
  // admin | doctor (senior) | junior_doctor | nurse | receptionist — see lib/rbac.ts
  role               String   @default("admin")
  // For role = doctor: the Doctor record this login belongs to
  doctorId           String?  @unique
  doctor             Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  active             Boolean  @default(true)
  // Set when an admin creates the account or resets the password: the user
  // picks their own password on next sign-in.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  sessions        Session[]
  templates       ConsultTemplate[]
  addenda         VisitAddendum[]
  payments        Payment[]
  invoicesCreated Invoice[]
  expenses        Expense[]
  labReports      LabReport[]

  visitsCheckedIn Visit[] @relation("VisitCheckedInBy")
  visitsTriaged   Visit[] @relation("VisitTriageBy")
  visitsConsulted Visit[] @relation("VisitConsultBy")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  // Set when the platform admin opened this hospital in support mode
  impersonatedBy String?
  createdAt      DateTime @default(now())
}

// ─── Scheduling config ─────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  doctors Doctor[]

  @@unique([clinicId, name])
}

model Doctor {
  id             String      @id @default(cuid())
  clinicId       String
  clinic         Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name           String
  specialty      String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  qualification  String?
  registrationNo String?
  slotMinutes    Int         @default(15)
  // Buffer between appointments, minutes
  bufferMinutes  Int         @default(0)
  // Consultation room/cabin shown on the token display
  room           String?
  // Fees in paise. A visit within `followUpDays` of the last completed visit
  // with the same doctor is billed at `followUpFee`.
  consultFee     Int         @default(50000)
  followUpFee    Int         @default(0)
  followUpDays   Int         @default(7)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  workingHours WorkingHour[]
  leaves       DoctorLeave[]
  templates    ConsultTemplate[]
  appointments Appointment[]
  visits       Visit[]
  user         User?
}

// One row per weekday window a doctor sees patients.
model WorkingHour {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday
  weekday  Int
  // Minutes from midnight, clinic-local. e.g. 540 = 09:00, 780 = 13:00
  startMin Int
  endMin   Int
}

// A doctor's own leave (inclusive date range). No slots are offered.
model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime // date only
  endDate   DateTime // date only, inclusive
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, startDate])
}

// Full-day closures (clinic-wide).
model Holiday {
  id       String   @id @default(cuid())
  clinicId String
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date     DateTime // date only; time part ignored
  reason   String?
}

// ─── Patients & bookings ───────────────────────────────────────────────────

model Patient {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  // Hospital-unique ID shown on cards and prescriptions, e.g. "UH000042".
  // Nullable only so pre-HMS rows survive `db push`; assigned on first save.
  uhid              String?
  // E.164, digits only — the contact number. Families often share one, so it
  // is NOT unique; `relation` says how this patient relates to its owner.
  waPhone           String
  relation          String? // self | spouse | child | parent | sibling | other
  name              String?
  gender            String? // male | female | other
  dob               DateTime? // date only
  bloodGroup        String?
  email             String?
  address           String?
  emergencyName     String?
  emergencyPhone    String?
  allergies         String?
  chronicConditions String?
  idType            String? // aadhaar | abha | pan | passport | other
  idNumber          String?
  createdAt         DateTime  @default(now())

  appointments Appointment[]
  visits       Visit[]
  invoices     Invoice[]
  labReports   LabReport[]
  labResults   LabResult[]

  @@unique([clinicId, uhid])
  @@index([clinicId, waPhone])
}

model Appointment {
  id        String  @id @default(cuid())
  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  status  String   @default("booked") // booked | cancelled | completed | no_show
  source  String   @default("whatsapp") // whatsapp | frontdesk
  note    String?

  createdAt DateTime @default(now())

  reminders Reminder[]
  visit     Visit?

  @@index([clinicId, startAt])
  @@index([doctorId, startAt])
}

model Reminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sendAt        DateTime
  offsetMinutes Int
  sentAt        DateTime?

  @@index([sendAt, sentAt])
}

// ─── OPD ───────────────────────────────────────────────────────────────────

// One outpatient encounter. Strict pipeline — see lib/encounter.ts:
// CHECKED_IN → TRIAGE_IN_PROGRESS → TRIAGE_COMPLETED → IN_CONSULTATION → COMPLETED
// (CANCELLED from any open state).
enum VisitStatus {
  CHECKED_IN
  TRIAGE_IN_PROGRESS
  TRIAGE_COMPLETED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

model Visit {
  id            String       @id @default(cuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // The senior doctor the patient is queued for
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Queue number per doctor per day
  token     Int
  status    VisitStatus @default(CHECKED_IN)
  // normal | priority | emergency — higher priority is called first
  priority  String      @default("normal")
  // new | follow_up — decided at check-in (drives the fee)
  visitType String      @default("new")

  checkedInById     String?
  checkedInBy       User?     @relation("VisitCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedInAt       DateTime  @default(now())
  triageById        String?
  triageBy          User?     @relation("VisitTriageBy", fields: [triageById], references: [id], onDelete: SetNull)
  triageStartedAt   DateTime?
  triageCompletedAt DateTime?
  consultById       String?
  consultBy         User?     @relation("VisitConsultBy", fields: [consultById], references: [id], onDelete: SetNull)
  consultStartedAt  DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  // Finalized prescription, rendered once at completion and never regenerated
  prescriptionPdf Bytes?
  pdfGeneratedAt  DateTime?

  // Vitals
  heightCm     Float?
  weightKg     Float?
  temperatureC Float?
  pulse        Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  spo2         Int?
  respRate     Int?

  // Consultation
  chiefComplaint     String?
  history            String?
  examination        String?
  diagnosis          String?
  icdCode            String?
  advice             String?
  followUpDate       DateTime? // date only
  // Follow-up desk: reminder sent / closed (booked, dismissed)
  followUpRemindedAt DateTime?
  followUpClosedAt   DateTime?
  // Prescription link sent to the patient on WhatsApp
  rxSentAt           DateTime?

  prescriptionItems PrescriptionItem[]
  addenda           VisitAddendum[]
  invoice           Invoice?

  @@index([clinicId, checkedInAt])
  @@index([clinicId, status])
  @@index([patientId, checkedInAt])
  @@index([clinicId, followUpDate])
}

// Corrections after a visit is finalized. The original record is never edited.
model VisitAddendum {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())
}

// Reusable consultation presets. doctorId null = shared with every doctor.
model ConsultTemplate {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name           String
  chiefComplaint String?
  examination    String?
  diagnosis      String?
  icdCode        String?
  advice         String?
  // [{ medicine, dosage, frequency, duration, instructions }]
  items          Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([clinicId, doctorId])
}

model PrescriptionItem {
  id           String  @id @default(cuid())
  visitId      String
  visit        Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicine     String
  dosage       String? // e.g. 500 mg
  frequency    String? // e.g. 1-0-1
  duration     String? // e.g. 5 days
  instructions String? // e.g. after food
  sortOrder    Int     @default(0)
}

// ─── WhatsApp conversation state ───────────────────────────────────────────

model Conversation {
  id       String  @id @default(cuid())
  waPhone  String  @unique
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  // Simple state machine — see lib/conversation.ts
  step  String @default("start")
  // JSON blob of in-progress selections (doctorId, date, slot, name…)
  draft String @default("{}")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ─── Billing ───────────────────────────────────────────────────────────────
// All amounts are integers in paise (₹1 = 100).

// Price list for chargeable services (dressing, ECG, injection…)
model ServiceItem {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name     String
  price    Int
  active   Boolean @default(true)

  @@unique([clinicId, name])
}

model Invoice {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  number         String // INV-000123, per hospital
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId        String?  @unique
  visit          Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  // unpaid | partial | paid | refunded | void
  status         String   @default("unpaid")
  subtotal       Int      @default(0)
  discount       Int      @default(0)
  discountReason String?
  total          Int      @default(0)
  // Net of refunds
  paid           Int      @default(0)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@unique([clinicId, number])
  @@index([clinicId, createdAt])
  @@index([clinicId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int     @default(1)
  unitPrice   Int
  amount      Int
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // payment | refund (refund amounts are stored positive)
  kind         String   @default("payment")
  amount       Int
  mode         String // cash | upi | card | other
  reference    String?
  reason       String?
  receivedById String?
  receivedBy   User?    @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([invoiceId])
  @@index([createdAt])
}

// ─── Audit trail ───────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  // e.g. patient.create, visit.finalize, invoice.refund
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, entity, entityId])
}

// ─── Expenses ──────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date        DateTime // date only
  // salaries | rent | utilities | consumables | equipment | maintenance | marketing | it | other
  category    String
  description String
  amount      Int // paise
  mode        String   @default("bank") // cash | upi | card | bank | cheque
  vendor      String?
  reference   String?
  // Repeats every month (rent, salaries) — copied forward from the Expenses page
  recurring   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([clinicId, date])
}

// ─── Sales (public website) ────────────────────────────────────────────────

// "Book a demo" requests from the marketing site; seen by the platform admin.
model Lead {
  id        String   @id @default(cuid())
  name      String
  hospital  String
  phone     String
  email     String?
  city      String?
  size      String? // clinic | 10-50 beds | 50-200 beds | 200+ beds
  message   String?
  status    String   @default("new") // new | contacted | won | lost
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Lab & diagnostic reports ──────────────────────────────────────────────

// An uploaded report (PDF / photo). The original file is kept unchanged; the
// AI reader extracts results + a doctor-facing summary (status: processing →
// ready | failed | unreadable).
model LabReport {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  mimeType     String
  sizeBytes    Int
  file         Bytes
  status       String    @default("processing")
  error        String?
  // Extracted header
  title        String? // e.g. "Comprehensive full body checkup"
  labName      String?
  reportType   String? // blood | urine | imaging | other
  collectedAt  DateTime? // date only
  reportedAt   DateTime? // date only
  nameOnReport String?
  // AI reader output: { headline, keyFindings[], patterns[], followUp[], nameMismatch }
  insights     Json?
  model        String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  results LabResult[]

  @@index([clinicId, patientId, createdAt])
  @@index([status])
}

// One measured value from a report, normalised so the same test can be
// trended across reports and labs.
model LabResult {
  id           String    @id @default(cuid())
  reportId     String
  report       LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  panel        String // see lib/labs.ts PANELS — fixed clinical order
  test         String // standard name, e.g. "Haemoglobin"
  testOnReport String?
  value        String
  numeric      Float?
  unit         String?
  refText      String?
  refLow       Float?
  refHigh      Float?
  flag         String // normal | low | high | critical_low | critical_high | abnormal | unknown
  page         Int?
  sortOrder    Int       @default(0)
  // Collection date copied from the report, for trends
  takenAt      DateTime?

  @@index([patientId, test, takenAt])
  @@index([reportId])
}
